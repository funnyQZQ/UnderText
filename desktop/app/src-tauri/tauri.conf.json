{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UnderText",
  "identifier": "dev.undertext.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeBundleCommand": "bash -c 'cd \"$(git rev-parse --show-toplevel)/desktop\" && scripts/fetch_llama_server.sh'"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "UnderText",
        "width": 980,
        "height": 230,
        "visible": false,
        "minWidth": 360,
        "minHeight": 90,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "UnderText 设置",
        "width": 580,
        "height": 720,
        "minWidth": 460,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 23
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "本地实时英译中字幕",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "frameworks": [
        "../../target/release/libsherpa-onnx-c-api.dylib",
        "../../target/release/libonnxruntime.dylib"
      ],
      "files": {
        "MacOS/llama-server": "../../third_party/llama.cpp/llama-server",
        "MacOS/libllama-server-impl.dylib": "../../third_party/llama.cpp/libllama-server-impl.dylib",
        "MacOS/libllama-common.0.dylib": "../../third_party/llama.cpp/libllama-common.0.dylib",
        "MacOS/libmtmd.0.dylib": "../../third_party/llama.cpp/libmtmd.0.dylib",
        "MacOS/libllama.0.dylib": "../../third_party/llama.cpp/libllama.0.dylib",
        "MacOS/libggml.0.dylib": "../../third_party/llama.cpp/libggml.0.dylib",
        "MacOS/libggml-base.0.dylib": "../../third_party/llama.cpp/libggml-base.0.dylib",
        "MacOS/libggml-cpu.0.dylib": "../../third_party/llama.cpp/libggml-cpu.0.dylib",
        "MacOS/libggml-blas.0.dylib": "../../third_party/llama.cpp/libggml-blas.0.dylib",
        "MacOS/libggml-metal.0.dylib": "../../third_party/llama.cpp/libggml-metal.0.dylib",
        "MacOS/libggml-rpc.0.dylib": "../../third_party/llama.cpp/libggml-rpc.0.dylib",
        "Resources/llama.cpp-LICENSE": "../../third_party/llama.cpp/LICENSE"
      }
    }
  }
}
